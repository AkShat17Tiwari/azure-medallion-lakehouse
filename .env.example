# ==============================================================================
# ENVIRONMENT & RUNTIME SETTINGS
# ==============================================================================
APP_ENV=development                       # development | staging | production
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
SPARK_APP_NAME=Lakehouse-Medallion-Engine
SPARK_MASTER=local[*]                     # local[*] for local testing, or spark://host:port for cluster

# ==============================================================================
# AZURE DATA LAKE STORAGE GEN2 (ADLS GEN2) CONFIGURATION
# ==============================================================================
# Storage Account Details
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
# Endpoint suffix is typically 'dfs.core.windows.net' for ADLS Gen2
AZURE_STORAGE_ENDPOINT_SUFFIX=dfs.core.windows.net

# Medallion Architecture Container / FileSystem Names
# Option A: Dedicated container per medallion layer (Recommended in Azure enterprise)
AZURE_CONTAINER_BRONZE=bronze
AZURE_CONTAINER_SILVER=silver
AZURE_CONTAINER_GOLD=gold
AZURE_CONTAINER_CHECKPOINT=checkpoints

# Authentication Mechanism: 'access_key' | 'sas_token' | 'service_principal'
AZURE_AUTH_TYPE=access_key

# ------------------------------------------------------------------------------
# Auth Method 1: Storage Account Shared Key (Full account access)
# Used with Spark config: fs.azure.account.key.<storage_account>.dfs.core.windows.net
# ------------------------------------------------------------------------------
AZURE_STORAGE_ACCESS_KEY=your_base64_encoded_storage_account_key_here

# ------------------------------------------------------------------------------
# Auth Method 2: Shared Access Signature (SAS Token)
# Note: SAS token can be specified with or without leading '?' (loader strips it)
# Used with Spark config: fs.azure.sas.<container>.<storage_account>.dfs.core.windows.net
# ------------------------------------------------------------------------------
AZURE_STORAGE_SAS_TOKEN=sv=2022-11-02&ss=bfqt&srt=sco&sp=rwdlacupx&se=2026-12-31T23:59:59Z&st=2026-01-01T00:00:00Z&spr=https&sig=your_signature_here

# ------------------------------------------------------------------------------
# Auth Method 3: Service Principal / Azure Active Directory (OAuth 2.0 Client Credentials)
# Recommended for production enterprise workloads
# Used with Spark configs:
#   fs.azure.account.auth.type.<account>.dfs.core.windows.net = OAuth
#   fs.azure.account.oauth.provider.type.<account>.dfs.core.windows.net = org.apache.hadoop.fs.azurebfs.oauth2.ClientCredsTokenProvider
#   fs.azure.account.oauth2.client.id.<account>.dfs.core.windows.net
#   fs.azure.account.oauth2.client.secret.<account>.dfs.core.windows.net
#   fs.azure.account.oauth2.client.endpoint.<account>.dfs.core.windows.net = https://login.microsoftonline.com/<tenant_id>/oauth2/token
# ------------------------------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your_service_principal_client_secret_value

# ==============================================================================
# POSTGRESQL (SERVING / GOLD CONSUMPTION LAYER) CONFIGURATION
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lakehouse_gold
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=prefer                    # disable | allow | prefer | require | verify-ca | verify-full

# psycopg2 / SQLAlchemy Connection URI:
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=<sslmode>
POSTGRES_URI=postgresql://postgres:your_secure_postgres_password@localhost:5432/lakehouse_gold?sslmode=prefer

# PySpark JDBC Connection URL:
# Format: jdbc:postgresql://<host>:<port>/<dbname>?sslmode=<sslmode>
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/lakehouse_gold?sslmode=prefer
POSTGRES_JDBC_DRIVER=org.postgresql.Driver

# ==============================================================================
# LOCAL FALLBACK / DEVELOPMENT STORAGE PATHS
# (Useful when running pipelines without active Azure credentials)
# ==============================================================================
USE_LOCAL_STORAGE_EMULATION=true          # Set to false to force ADLS Gen2 ABFSS endpoints
LOCAL_DATA_DIR=./data
LOCAL_BRONZE_PATH=./data/bronze
LOCAL_SILVER_PATH=./data/silver
LOCAL_GOLD_PATH=./data/gold
LOCAL_CHECKPOINT_PATH=./data/checkpoints

# ==============================================================================
# SPARK & DELTA LAKE PACKAGES & ENGINE SETTINGS
# ==============================================================================
# Maven coordinates for Azure Hadoop connector and PostgreSQL JDBC driver
# Automatically loaded in SparkSession via spark.jars.packages
SPARK_PACKAGES=io.delta:delta-spark_2.12:3.2.0,org.apache.hadoop:hadoop-azure:3.3.4,com.microsoft.azure:azure-storage:8.6.6,org.postgresql:postgresql:42.7.3

# Delta Lake Optimizations
DELTA_AUTO_COMPACT=true
DELTA_OPTIMIZE_WRITE=true
